{
  "name": "topological-compute-engine",
  "version": "0.0.1",
  "description": "A TypeScript engine for converting circuit JSON into topology graphs.",
  "type": "module",

  "scripts": {
    "test": "node --loader ts-node/esm --test",
    "build": "tsc -p tsconfig.json"
  },

  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },

  "ts-node": {
    "transpileOnly": true,
    "experimentalResolver": true,
    "compilerOptions": {
      "module": "ES2022",
      "moduleResolution": "node",
      "target": "ES2022",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true
    }
  }
}
